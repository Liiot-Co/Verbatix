
# --- Switcher local/Supabase ---
# local    -> Postgres local (docker-compose db service), storage en
#             disco (../data/uploads), auth bypaseado con un dev user fijo.
#             No pega a Supabase, no gasta free tier. Default.
# supabase -> Postgres/Storage/Auth reales de Supabase (requiere las
#             variables SUPABASE_* de abajo).
APP_MODE=local

# --- Local (app_mode=local) ---
# Ya trae default apuntando al docker-compose db service; solo hace falta
# si corrés Postgres en otro host/puerto/credenciales.
# DATABASE_URL=postgresql://verbatix:verbatix@localhost:5432/verbatix

# --- Supabase (obligatorias solo si APP_MODE=supabase) ---
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# URL del proyecto (Settings → API → Project URL)
# SUPABASE_URL=https://[PROJECT_REF].supabase.co

# Secret key del backend (Settings → API → secret key / service role)
# Solo en el servidor. Nunca en el frontend.
# SUPABASE_SECRET_KEY=sb_secret_[YOUR_SECRET_KEY]

# JWKS para verificar JWT de Auth (derivado de SUPABASE_URL)
# SUPABASE_JWKS_URL=https://[PROJECT_REF].supabase.co/auth/v1/.well-known/jwks.json

ENV=dev
HOST=0.0.0.0
PORT=8001

# --- Motor de clasificación ---
# El bootstrap auto-aprueba el libro construido desde cero y clasifica de corrido
# (el analista corrige en Resolución). Ponlo en false para exigir aprobación
# humana del borrador antes de clasificar (la ronda se detiene en codebook_review).
AUTO_APPROVE_SCRATCH_CODEBOOK=true
# Auto-cierre por etapa. Exacto/reglas de sistema siempre cierran; fuzzy/semántico/
# LLM cierran solo si pasan su gate calibrado (y nunca el 95 por modelo).
AUTO_COMMIT_EXACT_APPROVED=true
AUTO_COMMIT_BRAND_FUZZY=true
AUTO_COMMIT_SEMANTIC=true
AUTO_COMMIT_LLM=true
CLASSIFICATION_SHADOW_MODE=false
# Gate de auto-cierre del fuzzy de marcas (score 0-100 y margen top1-top2).
BRAND_FUZZY_AUTOCOMMIT_SCORE=88
BRAND_FUZZY_AUTOCOMMIT_MARGIN=5
# Bucket residual estilo Ascribe: lo que quede sin clasificar se cierra al código
# universal de confuso (95 Marcas / 97 Razones); el analista corrige en Resolución.
RESIDUAL_TO_CONFUSO=true

# CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# --- Smoke test local (opcionales) ---
# Usuario de Supabase Auth para scripts/smoke_local.py y .scripts/token.sh
# SUPABASE_TEST_EMAIL=analista@tu-dominio.com
# SUPABASE_TEST_PASSWORD=tu_password_seguro

# URL del API al correr smoke (por defecto http://127.0.0.1:8001)
# API=http://127.0.0.1:8001
