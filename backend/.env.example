
# --- Supabase (obligatorias) ---
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# URL del proyecto (Settings → API → Project URL)
SUPABASE_URL=https://[PROJECT_REF].supabase.co

# Secret key del backend (Settings → API → secret key / service role)
# Solo en el servidor. Nunca en el frontend.
SUPABASE_SECRET_KEY=sb_secret_[YOUR_SECRET_KEY]

# JWKS para verificar JWT de Auth (derivado de SUPABASE_URL)
SUPABASE_JWKS_URL=https://[PROJECT_REF].supabase.co/auth/v1/.well-known/jwks.json

ENV=dev
HOST=0.0.0.0
PORT=8001

# CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# --- Smoke test local (opcionales) ---
# Usuario de Supabase Auth para scripts/smoke_local.py y .scripts/token.sh
# SUPABASE_TEST_EMAIL=analista@tu-dominio.com
# SUPABASE_TEST_PASSWORD=tu_password_seguro

# URL del API al correr smoke (por defecto http://127.0.0.1:8001)
# API=http://127.0.0.1:8001
